generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum PermissionCode {
  GLOBAL_ASSET_LOOKUP
  GLOBAL_DASHBOARD_STATS
  ASSET_CREATE
  ASSET_EDIT
  ASSET_DELETE
  ASSET_MOVE
  IMPORT_ASSETS
  POOL_CREATE
  POOL_EDIT
  POOL_DELETE
  CATEGORY_CREATE
  CATEGORY_EDIT
  CATEGORY_DELETE
  FOLDER_CREATE
  FOLDER_DELETE
  STOCK_MANAGE
  NON_PATRIMONIAL_CREATE
  NON_PATRIMONIAL_EDIT
  NON_PATRIMONIAL_MOVE
  NON_PATRIMONIAL_ARCHIVE
  IMPORT_NON_PATRIMONIAL
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  RESERVED
  MAINTENANCE
  DAMAGED
  LOST
  LOANED
  DISPOSED
  SOLD
  INACTIVE
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits    AuditLog[]
  poolAccess UserPool[]
  permissions UserPermission[]
  permissionsInitialized Boolean @default(false)
  canGlobalAssetLookup Boolean @default(false)
  canGlobalDashboardStats Boolean @default(false)
  tokenVersion Int @default(0)
}

model UserPermission {
  userId     String
  permission PermissionCode
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@index([permission])
}

model Pool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     UserPool[]
  profiles    ItemProfile[]
  nonPatrimonialItems NonPatrimonialItem[]
  folders     Folder[]
  assets      Asset[]
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  description String?
  poolId      String
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pool        Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  parent      Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Folder[] @relation("FolderTree")
  assets      Asset[]

  @@unique([poolId, parentId, name])
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  profiles    ItemProfile[]
  nonPatrimonialItems NonPatrimonialItem[]
  assetTypes  AssetType[]
  customFields CustomField[]
  assets      Asset[]
}

model AssetType {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assets     Asset[]

  @@unique([categoryId, name])
}

model CustomField {
  id         String          @id @default(cuid())
  categoryId String
  name       String
  key        String
  type       CustomFieldType
  required   Boolean         @default(false)
  options    Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values     AssetCustomValue[]

  @@unique([categoryId, key])
}

model Asset {
  id              String      @id @default(cuid())
  patrimonyNumber String
  name            String
  description     String?
  serialNumber    String?
  manufacturer    String?
  model           String?
  purchasePrice   Decimal?    @db.Decimal(14, 2)
  purchaseDate    DateTime?
  status          AssetStatus @default(AVAILABLE)
  location        String?
  responsible     String?
  poolId          String
  folderId        String?
  categoryId      String
  assetTypeId     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  pool            Pool        @relation(fields: [poolId], references: [id], onDelete: Restrict)
  folder          Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assetType       AssetType?  @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  customValues    AssetCustomValue[]
  movements       AssetMovement[]
  components      AssetComponent[]

  @@unique([poolId, patrimonyNumber])
  @@index([name])
  @@index([serialNumber])
}

model AssetCustomValue {
  id            String      @id @default(cuid())
  assetId       String
  customFieldId String
  value         Json
  asset         Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([assetId, customFieldId])
}

model AssetMovement {
  id              String   @id @default(cuid())
  assetId         String
  fromPoolId      String?
  toPoolId        String?
  fromFolderId    String?
  toFolderId      String?
  fromLocation    String?
  toLocation      String?
  fromResponsible String?
  toResponsible   String?
  notes           String?
  createdAt       DateTime @default(now())
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

enum ImportKind {
  ASSET
  NON_PATRIMONIAL
}

model ImportJob {
  kind        ImportKind @default(ASSET)
  userId      String?
  poolIds     String[] @default([])
  id          String   @id @default(cuid())
  fileName    String
  fileType    String
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  errorRows   Int      @default(0)
  errors      Json?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Pool membership is explicit. Non-administrators without membership see no assets.
model UserPool {
  userId String
  poolId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  @@id([userId, poolId])
  @@index([poolId])
}

enum ComponentOrigin {
  FROM_STOCK
  REGISTER_INSTALLED
}

enum StockMovementType {
  RECEIPT
  WITHDRAWAL
  INSTALL_FROM_STOCK
  REGISTER_INSTALLED
  RETURN_TO_STOCK
  RETIRE_INSTALLED
}

// A reusable technical profile, not a physical unit. It is scoped to a pool.
model ItemProfile {
  id String @id @default(cuid())
  poolId String
  categoryId String
  name String
  description String?
  manufacturer String?
  model String?
  specifications String?
  availableQty Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  components AssetComponent[]
  movements StockMovement[]
  @@unique([poolId, name])
  @@index([categoryId, poolId])
}

model AssetComponent {
  id String @id @default(cuid())
  assetId String
  profileId String
  quantity Int
  origin ComponentOrigin
  installedAt DateTime @default(now())
  removedAt DateTime?
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  profile ItemProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  @@index([profileId, removedAt])
  @@index([assetId, removedAt])
}

// Append-only ledger. Asset/user IDs are historical references, deliberately not cascaded.
model StockMovement {
  id String @id @default(cuid())
  profileId String
  assetId String?
  userId String
  operationId String
  type StockMovementType
  quantity Int
  availableAfter Int
  notes String?
  createdAt DateTime @default(now())
  profile ItemProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  @@index([profileId, createdAt])
}

// Makes retries of a stock write safe: the same requestId never creates a second unit.
model StockOperation {
  id String @id
  userId String
  kind String
  inputHash String
  result Json
  createdAt DateTime @default(now())
}


enum NonPatrimonialMovementType {
  INITIAL
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  IMPORT_SET
}

model SystemCounter {
  key   String @id
  value Int    @default(0)
}

model NonPatrimonialItem {
  id           String   @id @default(cuid())
  internalCode String   @unique
  lineageId    String   @default(cuid())
  name         String
  description  String?
  manufacturer String?
  model        String?
  quantity     Int      @default(0)
  location     String?
  responsible  String?
  poolId       String
  categoryId   String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pool         Pool     @relation(fields: [poolId], references: [id], onDelete: Restrict)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements    NonPatrimonialMovement[]

  @@index([poolId, active])
  @@index([categoryId, active])
  @@index([lineageId, poolId, active])
  @@index([name])
}

model NonPatrimonialMovement {
  id                String   @id @default(cuid())
  itemId            String
  userId            String
  type              NonPatrimonialMovementType
  quantity          Int
  quantityBefore    Int
  quantityAfter     Int
  fromPoolId        String?
  toPoolId          String?
  counterpartItemId String?
  notes             String?
  createdAt         DateTime @default(now())
  item              NonPatrimonialItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([userId, createdAt])
}
